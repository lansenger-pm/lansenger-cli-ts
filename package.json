{
  "name": "lansenger-cli",
  "version": "1.0.4",
  "description": "CLI for Lansenger (蓝信) — send messages, manage groups, staff, departments, calendars, todos, and more",
  "main": "dist/main.js",
  "bin": {
    "lansenger": "dist/main.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "cli-table3": "^0.6.0",
    "lansenger-sdk-ts": "^1.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
